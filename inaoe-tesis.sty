    \renewcommand{\listtablename}{Lista de tablas}%
    \renewcommand{\abstractname}{Resumen}%
    \renewcommand{\bibname}{Referencias}%
  }
  \newcommand*{\inaoe@strBy}{Por:}
  \newcommand*{\inaoe@strReq}{Tesis sometida como requisito parcial para obtener el grado de:}
  \newcommand*{\inaoe@strAt}{en el}
  \newcommand*{\inaoe@strInst}{Instituto Nacional de Astrofísica,}
  \newcommand*{\inaoe@strInstB}{Óptica y Electrónica}
  \newcommand*{\inaoe@strSuper}{Asesor:}
  \newcommand{\inaoe@strCopy}{\copyright\ INAOE \inaoe@anio\par Derechos reservados\par
    \begin{flushleft}
      El autor otorga al INAOE el permiso de\\
      reproducir este documento total o\\
