\else
  \addto\captionsenglish{%
    \renewcommand{\chaptername}{Chapter}%
    \renewcommand{\tablename}{Table}%
    \renewcommand{\figurename}{Figure}%
    \renewcommand{\contentsname}{Contents}%
    \renewcommand{\listfigurename}{List of Figures}%
    \renewcommand{\listtablename}{List of Tables}%
    \renewcommand{\abstractname}{Abstract}%
    \renewcommand{\bibname}{References}%
  }
  \newcommand*{\inaoe@strBy}{By:}
  \newcommand*{\inaoe@strReq}{Thesis submitted as a requirement for obtaining the degree of:}
  \newcommand*{\inaoe@strAt}{at the}
  \newcommand*{\inaoe@strInst}{Instituto Nacional de Astrofísica,}
  \newcommand*{\inaoe@strInstB}{Óptica y Electrónica}
  \newcommand*{\inaoe@strSuper}{Supervised by:}
  \newcommand{\inaoe@strCopy}{\copyright\ INAOE \inaoe@anio\par All rights reserved\par
    \begin{flushleft}
      The author hereby grants the permission for full or\\
      partial reproduction and distribution of this\\
      document to INAOE while mentioning the source\\
  \end{flushleft}}
\fi

%% ------------------------------------------------------------
%%  METADATOS
%% ------------------------------------------------------------

\newcommand*{\inaoe@titulo}{Título de la tesis}
\newcommand*{\inaoe@autor}{Nombre del autor}
\newcommand*{\inaoe@asesor}{Nombre del asesor}
\newcommand*{\inaoe@grado}{Grado}
\newcommand*{\inaoe@mes}{}
\newcommand*{\inaoe@anio}{\the\year}

\newcommand{\tituloTesis}[1]{\gdef\inaoe@titulo{#1}}
\newcommand{\autor}[1]{\gdef\inaoe@autor{#1}}
\newcommand{\asesor}[1]{\gdef\inaoe@asesor{#1}}
\newcommand{\grado}[1]{\gdef\inaoe@grado{#1}}
\newcommand{\mes}[1]{\gdef\inaoe@mes{#1}}
\newcommand{\anio}[1]{\gdef\inaoe@anio{#1}}

%% Metadatos del PDF si el documento carga hyperref y no los definió
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \ifx\@pdftitle\@empty  \hypersetup{pdftitle={\inaoe@titulo}}\fi
    \ifx\@pdfauthor\@empty \hypersetup{pdfauthor={\inaoe@autor}}\fi
  }{}%
}

%% ------------------------------------------------------------
%%  ESTILO DE CAPÍTULOS
%% ------------------------------------------------------------

\newcommand*{\thickhrulefill}{%
  \leavevmode\leaders\hrule height 1ex\hfill\kern\z@}

%% Capítulos numerados
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{10\p@}%
  {\parindent \z@ \centering \reset@font
    \thickhrulefill\quad
    {\scshape \@chapapp\ \thechapter\ }%
    \quad \thickhrulefill
    \par\nobreak
    \vspace*{10\p@}%
    \interlinepenalty\@M
    \hrule
    \vspace*{10\p@}%
    %% Para recuperar los títulos en versalitas de versiones anteriores,
    %% añada \scshape justo antes de #1 en la línea siguiente.
    \Huge \bfseries #1\par\nobreak
    \par
    \vspace*{10\p@}%
    \hrule
    \vskip 100\p@
}}

%% Capítulos sin número  (\chapter*)
\renewcommand{\@makeschapterhead}[1]{%
  \vspace*{10\p@}%
  {\parindent \z@ \centering \reset@font
    \thickhrulefill
    \par\nobreak
    \vspace*{10\p@}%
    \interlinepenalty\@M
    \hrule
    \vspace*{10\p@}%
    \Huge \bfseries #1\par\nobreak
    \par
    \vspace*{10\p@}%
    \hrule
    \vskip 100\p@
}}

%% ------------------------------------------------------------
%%  PORTADA  (\portada)
%%
%%  Todo el contenido se dibuja en coordenadas absolutas de la
%%  hoja carta (cm, origen en la esquina inferior izquierda) por
%%  medio del gancho shipout/background del kernel. Por ello no
%%  depende de los márgenes del documento ni los modifica.
%% ------------------------------------------------------------

%% Bloque de texto centrado: 12 x 21.9 cm
\newcommand{\inaoe@portada@texto}{%
  \begin{minipage}[b][21.9cm][c]{12cm}
    \normalfont
    \begin{center}\normalsize
      \vspace{\stretch{1.2}}
      {\Large\bfseries\inaoe@titulo\par}
      \vspace{\stretch{0.8}}
      \inaoe@strBy\par
      \vspace{\stretch{0.2}}
      {\normalsize\bfseries\inaoe@autor\par}
      \vspace{\stretch{0.5}}
      {\inaoe@strReq\par}
      \vspace{\stretch{0.2}}
      \textbf{\MakeUppercase{\inaoe@grado}}
      \vspace{\stretch{0.2}}

      \inaoe@strAt

      \textbf{\inaoe@strInst}

      \textbf{\inaoe@strInstB}

      \ifx\inaoe@mes\@empty\else\inaoe@mes,\ \fi\inaoe@anio

      Tonantzintla, Puebla

      \vspace{\stretch{0.8}}
      {\inaoe@strSuper\par}
      {\bfseries\inaoe@asesor\par}
      \vspace{\stretch{0.5}}
      \vspace{\stretch{0.2}}

      {\inaoe@strCopy}

    \end{center}
  \end{minipage}%
}

%% Marco, logotipos y bloque de texto
\newcommand{\inaoe@portada@dibujo}{%
  \setlength{\unitlength}{1cm}%
  \begin{picture}(0,0)
    % Marco institucional
    {\color{DBlue}\linethickness{0.8mm}%
      \put(6.2,25.54){\line(1,0){13.3}}
      \put(6.2,2.348){\line(1,0){10.6}}
      \put(6.24,2.31){\line(0,1){23.2}}
      \put(19.46,25.58){\line(0,-1){20.5}}}
    % Logotipos
    \put(16.85,2.305){\includegraphics[scale=0.18]{cover/cmyk-original.jpg}}
    \put(2.7,2.3){\includegraphics[scale=.352]{cover/Inaoe.pdf}}
    % Texto (esquina inferior izquierda del bloque)
    \put(7.285,3.04){\inaoe@portada@texto}
  \end{picture}%
}

\newcommand*{\portada}{%
  \clearpage
  \AddToHookNext{shipout/background}{%
    \put(0,-\paperheight){\inaoe@portada@dibujo}}%
  \thispagestyle{empty}%
  \null\newpage
}

\endinput
