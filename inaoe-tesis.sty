\ifinaoe@spanish
  \setlocalecaption{spanish}{contents}{Índice}
  \setlocalecaption{spanish}{listfigure}{Lista de figuras}
  \setlocalecaption{spanish}{listtable}{Lista de tablas}
  \setlocalecaption{spanish}{bib}{Referencias}
  \setlocalecaption{spanish}{dedication}{Dedicatoria}
  \setlocalecaption{spanish}{acknowledgements}{Agradecimientos}
  \newcommand*{\inaoe@strBy}{Por:}
  \newcommand*{\inaoe@strByLower}{por}
  \newcommand*{\inaoe@strReq}{Tesis sometida como requisito parcial para obtener el grado de:}
  \newcommand*{\inaoe@strAt}{en el}
  \newcommand*{\inaoe@strSuper}{Asesor:}
  \newcommand*{\inaoe@strAdvisors}{Asesores:}
  \newcommand*{\inaoe@strRights}{Derechos reservados}
  \newcommand*{\inaoe@strGrant}{El autor otorga al INAOE el permiso de reproducir este
    documento total o parcialmente, citando la fuente.}
\else
  \setlocalecaption{english}{bib}{References}
  \setlocalecaption{english}{dedication}{Dedication}
  \setlocalecaption{english}{acknowledgements}{Acknowledgements}
  \newcommand*{\inaoe@strBy}{By:}
  \newcommand*{\inaoe@strByLower}{by}
  \newcommand*{\inaoe@strReq}{Thesis submitted as a requirement for obtaining the degree of:}
  \newcommand*{\inaoe@strAt}{at the}
  \newcommand*{\inaoe@strSuper}{Supervised by:}
  \newcommand*{\inaoe@strAdvisors}{Doctoral Advisors:}
  \newcommand*{\inaoe@strRights}{All rights reserved}
  \newcommand*{\inaoe@strGrant}{The author hereby grants the permission for full or partial
    reproduction and distribution of this document to INAOE while mentioning the source}
\fi

%% biblatex toma el título de la bibliografía de sus propias cadenas
\AddToHook{package/biblatex/after}{%
  \DefineBibliographyStrings{spanish}{bibliography={Referencias}, references={Referencias}}%
  \DefineBibliographyStrings{english}{bibliography={References}, references={References}}%
}

%% ------------------------------------------------------------
%%  METADATOS
%% ------------------------------------------------------------

\newcommand*{\inaoe@titulo}{Título de la tesis}
\newcommand*{\inaoe@autor}{Nombre del autor}
\newcommand*{\inaoe@asesor}{Nombre del asesor}
\newcommand*{\inaoe@grado}{Grado}
\newcommand*{\inaoe@mes}{}
\newcommand*{\inaoe@anio}{\the\year}
\newcommand*{\inaoe@requisito}{\inaoe@strReq}
\newcommand*{\inaoe@departamento}{Coordinación de Ciencias Computacionales}

\NewDocumentCommand{\tituloTesis}{m}{\gdef\inaoe@titulo{#1}}
\NewDocumentCommand{\autor}{m}{\gdef\inaoe@autor{#1}}
\NewDocumentCommand{\asesor}{m}{\gdef\inaoe@asesor{#1}}
\NewDocumentCommand{\grado}{m}{\gdef\inaoe@grado{#1}}
\NewDocumentCommand{\mes}{m}{\gdef\inaoe@mes{#1}}
\NewDocumentCommand{\anio}{m}{\gdef\inaoe@anio{#1}}
%% Línea sobre el grado en la portada; \requisito{} la omite
\NewDocumentCommand{\requisito}{m}{\gdef\inaoe@requisito{#1}}
%% Texto tras el © en la portada de propuesta
\NewDocumentCommand{\departamento}{m}{\gdef\inaoe@departamento{#1}}

%% Metadatos del PDF si el documento carga hyperref y no los definió
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \ifx\@pdftitle\@empty  \hypersetup{pdftitle={\inaoe@titulo}}\fi
    \ifx\@pdfauthor\@empty \hypersetup{pdfauthor={\inaoe@autor}}\fi
  }{}%
}

%% ------------------------------------------------------------
%%  ESTILO DE CAPÍTULOS
%% ------------------------------------------------------------

%% Distancias medidas sobre la plantilla Typst, entre líneas base y
%% bordes de regla, para que no dependan de la altura de los glifos.
\newcommand*{\inaoe@reglagruesa}{%
  \leaders\hrule\@height7.5\p@\@depth-3.5\p@\hfill}
\newcommand*{\inaoe@regla}{\hrule\@height\p@}

\newcommand{\inaoe@cabecera}[2]{%
  \ifx\relax#1\relax
    \vspace*{\dimexpr9.5\p@-\topskip}%
  \else
    \vspace*{\dimexpr21.2\p@-\topskip}%
    \nointerlineskip
    \vbox to\z@{\vss\hb@xt@\hsize{%
      \normalfont\inaoe@reglagruesa\quad\scshape#1\quad\inaoe@reglagruesa}}%
    \nobreak
    \vskip\dimexpr31.25\p@-\prevdepth
  \fi
  \inaoe@regla
  \nobreak
  \vskip10\p@
  \prevdepth\z@
  {\parindent\z@ \parskip\z@ \centering \interlinepenalty\@M
    \normalfont\Huge\bfseries\baselineskip25.86\p@ #2\par}%
  \nobreak
  \vskip\dimexpr31\p@-\prevdepth
  \inaoe@regla
  \vskip60\p@}

\renewcommand{\@makechapterhead}[1]{\inaoe@cabecera{\@chapapp\ \thechapter}{#1}}
\renewcommand{\@makeschapterhead}[1]{\inaoe@cabecera{}{#1}}

%% ------------------------------------------------------------
%%  ÍNDICES
%%  Entradas de capítulo como las de sección (sin negritas, con
%%  puntos) y sin espacio entre párrafos, como el índice de Typst.
%% ------------------------------------------------------------

\renewcommand*{\l@chapter}{\@dottedtocline{0}{\z@}{1.5em}}
\let\inaoe@starttoc\@starttoc
\renewcommand*{\@starttoc}[1]{\vskip\parskip{\parskip\z@\inaoe@starttoc{#1}}}

%% ------------------------------------------------------------
%%  PÁGINAS PRELIMINARES
%%  Capítulos sin número que aparecen en el índice.
%% ------------------------------------------------------------

\newcommand{\inaoe@preliminar}[1]{%
  \chapter*{#1}%
  \addcontentsline{toc}{chapter}{#1}}

\NewDocumentEnvironment{dedicatoria}{}{\inaoe@preliminar{\dedicationname}}{}
\NewDocumentEnvironment{agradecimientos}{}{\inaoe@preliminar{\acknowledgementsname}}{}
\NewDocumentEnvironment{resumen}{}{\inaoe@preliminar{\abstractname}}{}

%% Las listas de figuras y de tablas se omiten si el documento no
%% tiene figuras o tablas (se sabe desde la compilación anterior).
\newcommand*{\inaoe@marcar}[1]{%
  \if@filesw\immediate\write\@auxout{\string\inaoe@hay{#1}}\fi}
\newcommand*{\inaoe@hay}[1]{\global\@namedef{inaoe@hay@#1}{}}
\AddToHook{env/figure/begin}{\inaoe@marcar{lof}}
\AddToHook{env/table/begin}{\inaoe@marcar{lot}}

\let\inaoe@listoffigures\listoffigures
\let\inaoe@listoftables\listoftables
\RenewDocumentCommand{\listoffigures}{}{\ifcsname inaoe@hay@lof\endcsname\inaoe@listoffigures\fi}
\RenewDocumentCommand{\listoftables}{}{\ifcsname inaoe@hay@lot\endcsname\inaoe@listoftables\fi}

%% ------------------------------------------------------------
%%  PORTADAS  (\portada y \portadaPropuesta)
%%
%%  Se dibujan con el gancho shipout/background del kernel en
%%  coordenadas absolutas de la hoja carta (cm, origen en la esquina
%%  superior izquierda, y hacia abajo negativa), las mismas que la
%%  plantilla Typst. No dependen de los márgenes ni los modifican.
%% ------------------------------------------------------------

%% Marco institucional y logotipos comunes a ambas portadas
\newcommand*{\inaoe@marco}{%
  {\color{DBlue}%
    \put(6.2,-2.44){\rule{13.3cm}{0.8mm}}%
    \put(6.2,-25.63){\rule{10.6cm}{0.8mm}}%
    \put(6.2,-25.63){\rule{0.8mm}{23.2cm}}%
    \put(19.42,-22.86){\rule{0.8mm}{20.5cm}}}%
  \put(2.7,-2.4){\makebox(0,0)[lt]{\includegraphics[width=3.097cm]{cover/Inaoe.pdf}}}%
  \put(16.85,-22.57){\makebox(0,0)[lt]{\includegraphics[width=3.124cm]{cover/cmyk-original.jpg}}}%
}

%% Párrafos justificados con la última línea (y las cortadas con \\)
%% centradas, como el texto centrado y justificado de Typst.
\newcommand*{\inaoe@centrado}{%
  \leftskip\z@\@plus1fil \rightskip\z@\@plus-1fil \parfillskip\z@\@plus2fil
  \parindent\z@ \def\\{\hskip\z@\@plus2fil\break}}

%% #1: posición vertical (cm desde arriba), #2: altura, #3: contenido
\newcommand{\inaoe@bloque}[3]{%
  \put(6.85,-#1){\makebox(0,0)[lt]{%
    \parbox[t][#2][c]{12cm}{%
      \normalfont\normalsize\frenchspacing\parskip0.75em\inaoe@centrado #3}}}}

\newcommand*{\inaoe@fecha}{\ifx\inaoe@mes\@empty\else\inaoe@mes, \fi\inaoe@anio}

%% Salto vertical con la semántica de v() en Typst: sustituye el
%% espacio entre párrafos y el interlineado, de modo que mide desde la
%% línea base anterior hasta la altura de mayúsculas (7.94 pt) siguiente.
\newcommand*{\inaoe@v}[1]{%
  \vskip\dimexpr7.94\p@-\parskip-\baselineskip\relax\vskip#1\relax}

\newcommand*{\inaoe@textoTesis}{%
  \vskip-\parskip\vskip\stretch{1.2}%
  {\fontsize{14pt}{0pt}\selectfont\bfseries\baselineskip18.65\p@\inaoe@titulo\par}
  \inaoe@v{\stretch{0.8}}
  \inaoe@strBy\par
  \inaoe@v{\stretch{0.2}}
  \textbf{\inaoe@autor}\par
  \inaoe@v{\stretch{0.5}}
  \inaoe@requisito\par
  \inaoe@v{\stretch{0.2}}
  \textbf{\MakeUppercase{\inaoe@grado}}\par
  \inaoe@v{\stretch{0.2}}
  \inaoe@strAt\par
  \textbf{Instituto Nacional de Astrofísica,}\par
  \textbf{Óptica y Electrónica}\par
  \inaoe@fecha\par
  Tonantzintla, Puebla\par
  \inaoe@v{\stretch{0.8}}
  \inaoe@strSuper\ \textbf{\ignorespaces\inaoe@asesor}\par
  \inaoe@v{\stretch{0.7}}
  \copyright\ INAOE \inaoe@anio\\
  \inaoe@strRights\par
  {\leftskip\z@ \rightskip 2.3cm \parfillskip\z@\@plus1fil
    \hspace*{10mm}\inaoe@strGrant\par}
  \vskip-\prevdepth
}

\newcommand*{\inaoe@textoPropuesta}{%
  \parskip\z@ \centering
  {\fontsize{17.28pt}{0pt}\selectfont\bfseries\baselineskip26.13\p@
    \inaoe@titulo\\\inaoe@grado\par}
  \inaoe@v{1.8cm}
  \inaoe@strByLower\par
  \inaoe@v{0.75cm}
  \textbf{\inaoe@autor}\par
  \inaoe@v{1.3cm}
  \inaoe@strAdvisors\par
  \inaoe@v{1.3cm}
  \textbf{\ignorespaces\inaoe@asesor}\par
  \inaoe@v{2.2cm}
  Instituto Nacional de Astrofísica, Óptica y Electrónica\\
  \copyright\ \inaoe@departamento\par
  \inaoe@v{1.25cm}
  \inaoe@fecha\\
  Santa María de Tonantzintla, Puebla, CP 72840\par
  \vskip-\prevdepth
}

\newcommand{\inaoe@portada}[1]{%
  \clearpage
  \AddToHookNext{shipout/background}{\setlength{\unitlength}{1cm}\inaoe@marco#1}%
  \thispagestyle{empty}%
  \null\newpage
}

%% Portada oficial de tesis
\NewDocumentCommand{\portada}{}{%
  \inaoe@portada{\inaoe@bloque{1.5}{23.74cm}{\inaoe@textoTesis}}}

%% Portada de propuesta de tesis (formato de la Coordinación de
%% Ciencias Computacionales); sin derechos ni permiso de reproducción.
\NewDocumentCommand{\portadaPropuesta}{}{%
  \inaoe@portada{\inaoe@bloque{2.4}{20.17cm}{\inaoe@textoPropuesta}}}

\endinput
