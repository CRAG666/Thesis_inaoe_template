\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{inaoe-tesis}[2026/09/24 v2.0 Plantilla no oficial de tesis INAOE]

%% ------------------------------------------------------------
%%  OPCIONES DE IDIOMA
%% ------------------------------------------------------------

\newif\ifinaoe@spanish
\DeclareOption{spanish}{\inaoe@spanishtrue}
\DeclareOption{english}{\inaoe@spanishfalse}
\DeclareOption*{\PackageWarning{inaoe-tesis}{Opción desconocida: `\CurrentOption'}}
\ProcessOptions\relax

%% ------------------------------------------------------------
%%  CODIFICACIÓN E IDIOMA
%% ------------------------------------------------------------

\RequirePackage[T1]{fontenc}

\ifinaoe@spanish
  \RequirePackage[spanish,es-nodecimaldot]{babel}
\else
  \RequirePackage[english]{babel}
\fi

%% ------------------------------------------------------------
%%  TIPOGRAFÍA (TeX Gyre Termes/Heros/Cursor + newtxmath)
%% ------------------------------------------------------------

\RequirePackage{tgtermes}
\RequirePackage{tgheros}
\RequirePackage{tgcursor}
\RequirePackage{amsmath}   % newtxmath debe cargarse después de amsmath
\RequirePackage{newtxmath}

%% ------------------------------------------------------------
%%  PAQUETES AUXILIARES
%% ------------------------------------------------------------

\RequirePackage{graphicx}
\RequirePackage{xcolor}

%% ------------------------------------------------------------
%%  DISEÑO DE PÁGINA (carta)
%%  Margen izquierdo 1in + 1.5cm, cuerpo de 15.05 x 22.94 cm con
%%  su borde superior a 2.4 cm del papel. Ajustable con \geometry{}.
%% ------------------------------------------------------------

\RequirePackage[
  letterpaper,
  left=4.04cm,
  width=15.05cm,
  top=2.4cm,
  height=22.94cm,
  headheight=0.6cm,
  headsep=0.66cm,
  footskip=30pt,
  marginparwidth=44pt,
  marginparsep=10pt,
]{geometry}

%% ------------------------------------------------------------
%%  SANGRÍA E INTERLINEADO
%% ------------------------------------------------------------

\setlength{\parskip}{0.75em}
\setlength{\parindent}{10mm}
\linespread{1.5}

%% ------------------------------------------------------------
%%  COLOR INSTITUCIONAL
%% ------------------------------------------------------------

\definecolor{DBlue}{rgb}{0.156, 0.121, 0.427}

%% ------------------------------------------------------------
