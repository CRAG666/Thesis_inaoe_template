%%  Plantilla LaTeX para la elaboración de tesis del
%%  Instituto Nacional de Astrofísica, Óptica y Electrónica (INAOE).
%%  Este paquete configura estilos tipográficos, portada,
%%  formato de capítulos y otros elementos estructurales
%%  comúnmente requeridos en tesis del instituto. Produce el mismo
%%  documento que la versión Typst de la plantilla.
%%
%%  Uso:
%%      \usepackage[english]{inaoe-tesis}   % tesis en inglés
%%      \usepackage[spanish]{inaoe-tesis}   % tesis en español
%%
%%  Requisitos:
%%      LaTeX 2021-11-15 o posterior. Motores: pdflatex (TeX Gyre
%%      Termes vía newtx), lualatex, xelatex o tectonic (TeX Gyre
%%      Termes y TeX Gyre Termes Math vía fontspec y unicode-math).
%%
%%  Repositorio del proyecto:
%%      https://github.com/CRAG666/Thesis_inaoe_template
%%
%% ============================================================

\NeedsTeXFormat{LaTeX2e}[2021-11-15]
\ProvidesPackage{inaoe-tesis}[2026/10/11 v3.0 Plantilla no oficial de tesis INAOE]

%% ------------------------------------------------------------
%%  OPCIONES DE IDIOMA
%% ------------------------------------------------------------

\newif\ifinaoe@spanish
\DeclareOption{spanish}{\inaoe@spanishtrue}
\DeclareOption{english}{\inaoe@spanishfalse}
\ProcessOptions\relax

%% ------------------------------------------------------------
%%  IDIOMA
%% ------------------------------------------------------------

\ifinaoe@spanish
  \RequirePackage[spanish,es-tabla,es-nodecimaldot,es-nosectiondot]{babel}
\else
  \RequirePackage[english]{babel}
\fi

%% ------------------------------------------------------------
%%  TIPOGRAFÍA (TeX Gyre Termes, como la plantilla Typst)
%% ------------------------------------------------------------

\RequirePackage{iftex}
\RequirePackage{mathtools}
\iftutex
  \RequirePackage{unicode-math}
  \setmainfont{texgyretermes}[Extension=.otf, UprightFont=*-regular,
    BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
  \setsansfont{texgyreheros}[Extension=.otf, UprightFont=*-regular,
    BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
  \setmonofont{texgyrecursor}[Extension=.otf, UprightFont=*-regular,
    BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
  \setmathfont{texgyretermes-math.otf}
\else
  \RequirePackage[T1]{fontenc}
  \RequirePackage{newtxtext}
  \RequirePackage{newtxmath}
\fi

%% ------------------------------------------------------------
%%  PAQUETES AUXILIARES
%% ------------------------------------------------------------

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{caption}
\captionsetup[table]{position=top}

%% ------------------------------------------------------------
%%  DISEÑO DE PÁGINA (carta)
%%  Márgenes: izquierdo 4.04 cm, derecho 2.5 cm, superior 2.4 cm.
%%  Ajustable con \geometry{}.
%% ------------------------------------------------------------

\RequirePackage[
  letterpaper,
  left=4.04cm,
  width=15.05cm,
  top=2.4cm,
  height=22.94cm,
  headheight=0.6cm,
  headsep=0.66cm,
  footskip=30pt,
  marginparwidth=44pt,
  marginparsep=10pt,
]{geometry}

%% ------------------------------------------------------------
%%  SANGRÍA E INTERLINEADO
%%  17.33 pt entre líneas base a 12 pt, como la plantilla Typst.
%% ------------------------------------------------------------

\setlength{\parskip}{0.75em}
\setlength{\parindent}{10mm}
\linespread{1.195}

%% ------------------------------------------------------------
%%  COLOR INSTITUCIONAL
%% ------------------------------------------------------------

\definecolor{DBlue}{RGB}{40,31,109}

%% ------------------------------------------------------------
%%  NOMBRES Y CADENAS SEGÚN EL IDIOMA
